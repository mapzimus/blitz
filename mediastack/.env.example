# ── User/group for file permissions ──────────────────────────────────────────
# Run: id $(whoami)  to get your PUID and PGID
PUID=1000
PGID=1000

# ── Timezone ──────────────────────────────────────────────────────────────────
TZ=America/New_York

# ── Data directories on brontosaurus ─────────────────────────────────────────
# All media lives under DATA_DIR with this layout:
#   /mnt/media/
#     torrents/
#       movies/        ← qBittorrent downloads here
#       tv/
#     media/
#       movies/        ← Radarr moves finished files here
#       tv/            ← Sonarr moves finished files here
DATA_DIR=/mnt/media
MEDIA_DIR=/mnt/media/media
CONFIG_DIR=/opt/mediastack/config

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# Get this from: dash.cloudflare.com → Zero Trust → Networks → Tunnels
# Create a tunnel, copy the token from the "Docker" install instructions
CF_TUNNEL_TOKEN=your-tunnel-token-here
