# ── User / Group (from: wsl -e id) ──────────────────────────
PUID=1000
PGID=1000

# ── Timezone ─────────────────────────────────────────────────
TZ=America/New_York

# ── Paths (Windows absolute paths work via Docker Desktop) ───
# DATA_DIR: root for media/ and torrents/ subdirs
# Pick a drive with space — D: has ~500 GB free
DATA_DIR=D:/mediastack/data

# CONFIG_DIR: persistent app config (small, any drive is fine)
CONFIG_DIR=D:/mediastack/config

# ── Cloudflare Tunnel token ──────────────────────────────────
# dash.cloudflare.com → Zero Trust → Networks → Tunnels
# → Create tunnel → Docker → copy the token value only
CF_TUNNEL_TOKEN=paste_your_token_here
